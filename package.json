  "description": "Kubernetes practical exercises with Kind + Kubectl + GKE",
  "keywords": [
    "k8s",
    "kubernetes",
    "kind",
    "kubectl"
  ],
  "homepage": "https://github.com/itpzzi/fc-kubernetes#readme",
  "bugs": {
    "url": "https://github.com/itpzzi/fc-kubernetes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itpzzi/fc-kubernetes.git"
  },
  "license": "ISC",
  "author": "Ítalo Polazzi",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
